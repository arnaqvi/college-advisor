# Application
APP_NAME=College Advisor
ENVIRONMENT=local
DEBUG=true

# Database (SQLAlchemy 2.0 async) — no schema yet, wired in a later phase.
# Local default uses SQLite; point at Postgres when ready, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/college_advisor
DATABASE_URL=sqlite+aiosqlite:///./college_advisor.db

# Google OAuth (public self-serve login, added in a later phase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CORS_ORIGINS=["*"]

# College Scorecard sync (app/services/scorecard_sync.py) — free key, get one
# at https://api.data.gov/signup/ (no approval wait, arrives by email in
# seconds). Required for POST /api/colleges/sync; without it the sync
# endpoint responds with a structured "not configured" message instead of
# calling the API. US schools only — see scorecard_sync.py's module docstring.
COLLEGE_SCORECARD_API_KEY=
