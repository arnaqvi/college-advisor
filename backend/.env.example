# Application
APP_NAME=College Advisor
ENVIRONMENT=local
DEBUG=true

# Base URL used to build browser-facing redirect links (Stripe Checkout
# success/cancel, Google OAuth callback, password-reset emails). Set to your
# real domain in production.
FRONTEND_BASE_URL=http://localhost:5173

# Database (SQLAlchemy 2.0 async), real Postgres in production.
# Local default uses SQLite.
DATABASE_URL=sqlite+aiosqlite:///./college_advisor.db

# Signs the session cookie — generate a real random value for production
# (e.g. `openssl rand -base64 48`) and never rotate it, or every active
# session gets invalidated.
SESSION_SECRET_KEY=dev-insecure-session-secret-change-me
SESSION_MAX_AGE_DAYS=30

# Google OAuth (public self-serve login, wired but currently inert)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CORS_ORIGINS=["*"]

# College Scorecard sync (app/services/scorecard_sync.py) — free key, get one
# at https://api.data.gov/signup/ (no approval wait, arrives by email in
# seconds). Required for POST /api/colleges/sync; without it the sync
# endpoint responds with a structured "not configured" message instead of
# calling the API. US schools only — see scorecard_sync.py's module docstring.
COLLEGE_SCORECARD_API_KEY=

# Stripe (app/routers/billing.py) — test-mode keys from your own Stripe
# account. Without these, checkout responds "not_configured" instead of
# calling Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Password-reset email delivery (app/core/email.py) — any SMTP provider.
# Without smtp_host set, reset links are logged server-side instead of
# emailed (dev-friendly fallback, not meant for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_TOKEN_MAX_AGE_MINUTES=60

# Contact Us / feedback form (app/routers/feedback.py) — reuses the SMTP_*
# settings above for delivery.
FEEDBACK_TO_EMAIL=admin@collegepath.io

# AI Advisor chat (app/routers/advisor.py) — get a key at console.anthropic.com.
# Required for POST /api/advisor/chat; without it the endpoint responds with a
# structured "not configured" message instead of calling the API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Meta Conversions API (app/services/meta_capi.py) — reports a server-side
# Purchase event once Stripe payment is verified, for Meta ad optimization.
# Dataset already exists in Events Manager ("collegepath", ID
# 1116003507523517); generate the access token from that dataset's Settings
# tab. Without it, the Purchase event is skipped (logged, not an error).
META_DATASET_ID=1116003507523517
META_CAPI_ACCESS_TOKEN=
